  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceItem
  evidenceId: electricity_receipt
  title: "\u041A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044F \u0437\u0430 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E"
  description: "\u0421\u0447\u0435\u0442\u0430 \u0437\u0430 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B\u0438 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u044F \u043E\u0442\u0446\u0430. \u041A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0435\u0437\u0436\u0430\u043B."
