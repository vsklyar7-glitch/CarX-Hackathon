  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a839684927fecdc4a96c201e2212041a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceItem
  evidenceId: father_note
  title: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u043E\u0442\u0446\u0430"
  description: "\xAB\u0410\u043B\u0451\u0448\u0430, \u043D\u0435 \u0432\u0438\u043D\u0438 \u0441\u0435\u0431\u044F. \u0422\u044B \u0431\u044B\u043B \u0440\u0435\u0431\u0451\u043D\u043A\u043E\u043C \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B \u043C\u043E\u044E \u043F\u0440\u043E\u0441\u044C\u0431\u0443. \u042F \u0441\u0430\u043C \u0440\u0435\u0448\u0438\u043B \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0437\u0430 \u0434\u0432\u0435\u0440\u044C\u044E, \u0447\u0442\u043E\u0431\u044B \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0413\u043B\u0443\u0431\u0438\u043D\u0443. \u041F\u0440\u043E\u0441\u0442\u0438 \u043C\u0435\u043D\u044F\xBB. \u2014 \u041E\u0442\u0435\u0446."
  image: {fileID: 0}
