  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a839684927fecdc4a96c201e2212041a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceItem
  evidenceId: child_drawing
  title: "\u0414\u0435\u0442\u0441\u043A\u0438\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A"
  description: "\u0414\u0435\u0442\u0441\u043A\u0438\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A: \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0410\u043B\u0435\u043A\u0441\u0435\u0439, \u043E\u0442\u0435\u0446 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u0430\u044F \u0434\u0432\u0435\u0440\u044C. \u042F \u0443\u0437\u043D\u0430\u044E \u0441\u0432\u043E\u0439 \u043F\u043E\u0447\u0435\u0440\u043A. \u041E\u0442\u0435\u0446 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u043C\u0435\u043D\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0435\u0451, \u0438 \u044F \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u043B\u0441\u044F, \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0439."
  image: {fileID: 0}
