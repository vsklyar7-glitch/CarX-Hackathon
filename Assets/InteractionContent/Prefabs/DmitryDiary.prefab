  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceItem
  evidenceId: dmitry_diary
  title: "\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u0414\u043C\u0438\u0442\u0440\u0438\u044F"
  description: "\xAB\u042F \u0445\u043E\u0442\u0435\u043B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0435\u0433\u043E. \u042F \u0431\u044B\u043B \u0432 \u044F\u0440\u043E\u0441\u0442\u0438, \u043D\u043E \u043D\u0435 \u0441\u043C\u043E\u0433 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u043E, \u0447\u0442\u043E \u0437\u0430\u0434\u0443\u043C\u0430\u043B. \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0439 \u043D\u043E\u0447\u0438 \u043C\u044B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u043C\u043E\u043B\u0447\u0430\u0442\u044C\xBB. \u2014 \u0414\u043C\u0438\u0442\u0440\u0438\u0439."
  notebookDescription: 
  image: {fileID: 0}
