  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a839684927fecdc4a96c201e2212041a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EvidenceItem
  evidenceId: family_photo
  title: "\u0421\u0435\u043C\u0435\u0439\u043D\u0430\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F"
  description: "\u041E\u0442\u0435\u0446 \u0438 \u0442\u0440\u043E\u0435 \u0441\u044B\u043D\u043E\u0432\u0435\u0439: \u0414\u043C\u0438\u0442\u0440\u0438\u0439, \u0418\u0432\u0430\u043D \u0438 \u044F. \u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0440\u0443\u0434\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u043C\u044B \u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435."
  notebookDescription: "\u041E\u0442\u0435\u0446 \u0438 \u0442\u0440\u043E\u0435 \u0441\u044B\u043D\u043E\u0432\u0435\u0439: \u0414\u043C\u0438\u0442\u0440\u0438\u0439, \u0418\u0432\u0430\u043D \u0438 \u044F. \u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0440\u0443\u0434\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u043C\u044B \u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435."
  image: {fileID: 0}
  requiresPhotoAssembly: 0
  tornPhotoVisual: {fileID: 0}
  intactPhotoVisual: {fileID: 0}
